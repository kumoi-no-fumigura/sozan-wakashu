 ],
 "poems": [
  {
   "seq": "1",
   "text": "あきらかひおきまるや人の仕しくれなにはもふみやおもて",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "こほりゐしのなかのしみつうちとけてもとのこらろにかへるはるかな",
   "kana": "",
   "speaker": "森文庫",
   "page": 3,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "あふさしかのせまちをこえてあらたまのなしのこなたに春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "うちにはるたちける日"
  },
  {
   "seq": "4",
   "text": "春のよのならひになしてみる人もならみぬものとつきやかすめる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "つゐに身のけほりとならんはてやなを花にたちそふかすみならまし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "ゆてはるをしはしとなかんは道にもかへさりかれはいふかひもなし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "たちのはなはひまつはれよいまはとてかへらんはるのつくきわかれに",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "あはてそゝかへるうたゝねのとて世をのかれてこゝかしこありま",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "ほとしますなれもみやまをいてゝるはいとてかたえふ東もやなからん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "さそひくるあまの野かせやみたるかんをちたちになるすゝむしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "たひのこみなにかわひしき世をすて事にし身にはふるさともなし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "つきに手これぬあまのうこしかせ月を見てよめる",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "みつくさまよろすめるつましかけみつくさきよろすめる",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "そのまゝにわれころたのめひとはよのかはるならひにちよりをけけ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "わかそてはいか高かはかはとくりのゆふへのほかのあきのこゝろに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "くりかへしとをすむかしをしつかなることのうちとのふみに見るかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "のりのみちおしむためにはよのうさなけよしほともぬるゝろてかは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "まつにのみなをふりつみてふゆかれのこすゑにかろま庭のしらゆき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "ひに開結二経をみつからかまて供養に三十乙哥すゝめける此",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "いかにしてしばしたもたんうき身さへうけかたま世にあへるみのりを",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "愛のめなをたゝわれはともすくふへみをしへたへなるのりのこゝろを",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "さひしさもたさこそまされあらしたにまつにをとせぬゆにのやまさと",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "いけのおもは夜生のあこしにうちはてゝ松にのこれるなみのをとしかな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
