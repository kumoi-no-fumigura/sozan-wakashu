   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "ろも不よくさのさとをはかれすとはんとておもふといひし人に",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "かれすとへ日とのこゝろはあさくともたゝふかくさのさとのあはれを",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "一むとの雲さへあまのひかりにてくまなきからにすめるつまかせ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "さかぬ事にきゆるもつゝしはなみてあるへきものを見手のしくゆき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "ちるはなはかねにうら見てなくさめにくれゆくはるをたれにかただむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "はかなさやゆめにまさらむおもかけのけふりにきゆるやみのうつゝは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "うしやまたいかにまされんしつかなるにはのこゝろにあすもくれなく",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "かたふかてしはしやすらへ候こきなにほしのくらねにむかにつにかけ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "いつきてかねさめむなしまとこのうへにまくらもしらぬゆめをのこさむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "さとのいぬのあとのみみえてふる雪もいとゝふかくさふゆうさひしよ",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "遣ふくれてあすはまたこんにしなれともとのつき日のかへりやはする",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "くさまくらわれにてしりぬゆく春もこよひしかりねのとこやつゆき",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "なつけかをのゝしのはらつゆちりてしのふにあまるかけのいろかな",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "めのまへの世をこそなけゝおほかたはうし東もしこしあまのゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "なけらしるまよひきにける身をしれはわかふるさともかりのやとりを",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "四方の海みつのひしりの見ちなからむかしのなみにかへる御代かな",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "なかに夜もなしに折ふてふくさの名にあくるほとなきすみのえのつき",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "あふさみるいろちあまりのくらゐやまふもとのちりの身をいかにせん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "あしひかのやまほとゝきすこゝろ東也うき世にいてゝ手をはなくらむ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "よろしにかの路哥の句をとりて趣をさくりてつきを",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "だくひやはあり河けの山のほとゝよす月もくもまのそらのひとこゑ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "おしからぬ身を。おもふにもはのためすつるかひなまわれそかなしに",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "おもへ人かたにためしのいはほにもなかるゝみつのあとは見えたり",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "さとりあれは月日高らさぬ中からのやみにもひとのみちやまよはぬ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "はらひみよこゝろにつもるちりひちのやまのはなくはつきもつたて",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "あふさよのこのしたくらに秋よりにひとりみはしる覚ちつよのこま",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "詩つくりたるに西といふ文字をみていたくさまさ",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "白妙に匂ひしみねのくもよみてみとりをそむるよもの春西",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "みねのくもたにのかすみにくちぬへしうま世にそめぬあさのさころも",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "こゝろから身をうちかけのあしろもにはかなすわさに日をゝくならん",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "ほにいつるそてとはなしにはなすらにいらに万年にてあまのきぬらむ",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "まれにみしひとめもかれてふゆかれのものとさしはつかくるなき",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "とふ人もとはてほかふるさみたれにくれはゆまゝのたゆる事もなす",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "身をさらぬこゝろをともとさためひはひとりすむへきやまのおくかは",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "なをふかきやこのおくともいそかれす手さめのとゝにこゝろすむよは",
   "kana": "",
   "speaker": "",
   "page": 28,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "いかにしていかにむくひんかまりなすにらをあふまて手にはなくとも",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "たの覚しなあてねにのりの日よりにはひとのこゝろのやみものこ良し",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "おやのゝこせるかたみとおもへはおなし東しのくれに",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "市をほかまやとにこりつむ山かいのなれこのなかにこしもくれけり",
   "kana": "",
   "speaker": "",
   "page": 30,
   "pid": "nijl-100056420",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七衣",
   "kotobagaki": ""
  }
 ],
 "catalog": {
